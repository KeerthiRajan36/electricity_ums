# Copy this file to `.env` and adjust as needed. All values shown are the
# built-in defaults from app/config.py, so `.env` is optional for local dev.

# --- Database ---
# SQLite (zero setup, default):
DATABASE_URL=sqlite:///./electricity.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/electricity_db

# --- JWT ---
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=*

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Billing defaults ---
LATE_FEE_FLAT_AMOUNT=100.0
TAX_PERCENTAGE=5.0
BILL_DUE_DAYS=15

ENVIRONMENT=development
